{
  "name": "kumbhconnect-android",
  "version": "1.4.2",
  "private": true,
  "description": "Capacitor Android build scaffold for KumbhConnect",
  "scripts": {
    "prepare:web": "node scripts/android/prepare-web.mjs",
    "android:sync": "npm run prepare:web && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.2",
    "@capacitor/local-notifications": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "@capacitor/network": "^7.0.2",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.8.3"
  }
}
